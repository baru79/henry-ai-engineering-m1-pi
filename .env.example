# ==========================================
# Configuración de Nubbix Triage AI
# ==========================================

# Proveedor por defecto: 'groq', 'gemini' o 'openrouter'
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Claves de API de proveedores gratuitos (obtené la de tu preferencia):
# 1. Groq: https://console.groq.com/keys
GROQ_API_KEY=tu_groq_api_key_aqui

# 2. Google AI Studio (Gemini): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_gemini_api_key_aqui

# 3. OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=tu_openrouter_api_key_aqui

# Versión de prompt por defecto ('v1_zero_shot' o 'v2_few_shot')
PROMPT_VERSION=v2_few_shot

# Extra Credit: Activar caché MD5 para consultas idénticas (true / false)
CACHE_ENABLED=true

# Ruta del archivo de métricas estructuradas (append-only)
METRICS_FILE_PATH=data/metrics.jsonl
